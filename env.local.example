# Kopieer dit bestand naar .env.local en vul je eigen Supabase-gegevens in.
# Je vindt deze in je Supabase-project onder: Project Settings -> API
# (Zet dezelfde twee waarden ook in Vercel onder Settings -> Environment Variables.)

NEXT_PUBLIC_SUPABASE_URL=https://JOUWPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-public-key
